{
  "name": "OpenCode Root Server (anomalyco/opencode)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "root",
  "containerUser": "root",
  "privileged": true,
  "capAdd": [
    "SYS_ADMIN",
    "NET_ADMIN",
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "forwardPorts": [
    4096,
    3000
  ],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode Web UI (root)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "npm install -g opencode-ai@latest",
  "postStartCommand": "nohup opencode serve --port 4096 --hostname 0.0.0.0 > /var/log/opencode.log 2>&1 &",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}